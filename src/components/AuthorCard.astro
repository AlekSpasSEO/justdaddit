---
const { compact = false } = Astro.props;
const avatar = 'https://avatars.githubusercontent.com/u/131162811?v=4';
---
<aside class:list={['author-card', { compact }]} aria-label="About the author">
  <img src={avatar} alt="Aleksandar Spasevski" width="128" height="128" loading="lazy" />
  <div>
    <p class="micro-label">Researched and written by</p>
    <h2>Aleksandar Spasevski</h2>
    <p>Founder of JustDaddit, father, marketer, and the person who reads the manual before the first battery finishes charging.</p>
    <a href={`${import.meta.env.BASE_URL}about/`}>Why I built JustDaddit</a>
  </div>
</aside>
