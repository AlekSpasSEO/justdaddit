---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand brand-footer" href={base}><span>JUST</span><strong>DADDIT</strong><i aria-hidden="true"></i></a>
      <p>Research-backed gear for family adventures, projects, travel, and outdoor play.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href={`${base}about/`}>About</a>
      <a href={`${base}how-we-research/`}>Research policy</a>
      <a href={`${base}rc-cars/`}>RC cars</a>
    </nav>
    <div class="footer-small">
      <p><strong>Independent by design.</strong></p>
      <p>We may earn a commission from qualifying purchases. That never changes what we say.</p>
    </div>
  </div>
  <div class="shell footer-bottom"><span>© 2026 JustDaddit</span><span>Built for better weekends.</span></div>
</footer>
